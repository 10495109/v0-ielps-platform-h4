[Unit]
Description=IELPS learner runtime
After=network.target eilps-api.service

[Service]
Type=simple
User=eilps
Group=eilps
WorkingDirectory=/var/www/eilps/learner-current
Environment=NODE_ENV=production
EnvironmentFile=-/etc/eilps/learner.env
ExecStart=/usr/bin/node /var/www/eilps/learner-current/runtime/learner-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/eilps /var/cache/eilps

[Install]
WantedBy=multi-user.target
