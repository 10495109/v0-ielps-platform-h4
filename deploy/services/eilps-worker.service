[Unit]
Description=IELPS background worker
After=network.target postgresql.service redis-server.service eilps-api.service

[Service]
Type=simple
User=eilps
Group=eilps
WorkingDirectory=/var/www/eilps/backend-current
Environment=NODE_ENV=production
EnvironmentFile=-/etc/eilps/worker.env
ExecStart=/usr/bin/node /var/www/eilps/backend-current/scripts/job-worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/eilps /var/cache/eilps

[Install]
WantedBy=multi-user.target
